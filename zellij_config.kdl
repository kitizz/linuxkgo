// As suggested here: https://www.reddit.com/r/zellij/comments/17863uf/comment/k4yjkqd/?utm_source=share&utm_medium=web2x&context=3
default_mode "locked"

// iTerm doesn't report its light/dark palette, so default to dark and toggle with Alt m
theme_dark "gruvbox-dark"
theme_light "gruvbox-light"
explicit_theme_hue "dark"

show_startup_tips false

pane_frames false

plugins {
    // Status bar used by zellij_layout.kdl, styled like the built-in one
    // using gruvbox-dark colours. Keep the hints in sync with the keybinds.
    zjstatus location="file:~/.config/zellij/plugins/zjstatus.wasm" {
        format_left  "{mode}"
        format_right "#[fg=$text,bg=$bar]{session} "
        format_space "#[bg=$bar]"

        color_bar    "#3c3836"
        color_text   "#fbf1c7"
        color_ribbon "#ebdbb2"
        color_active "#98971a"
        color_alert  "#d65d0e"
        color_key    "#cc241d"

        mode_locked "#[fg=$bar,bg=$active,bold] LOCKED #[fg=$active,bg=$bar]#[fg=$text,bg=$bar,bold] Ctrl + #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <g> #[fg=$bar,bg=$ribbon,bold]UNLOCK #[fg=$ribbon,bg=$bar] #[fg=$text,bg=$bar,bold] Alt + #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <t> #[fg=$bar,bg=$ribbon,bold]NEW TAB #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <[]> #[fg=$bar,bg=$ribbon,bold]PREV/NEXT TAB #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <r> #[fg=$bar,bg=$ribbon,bold]RENAME #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <ijkl> #[fg=$bar,bg=$ribbon,bold]FOCUS #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <-=> #[fg=$bar,bg=$ribbon,bold]RESIZE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <m> #[fg=$bar,bg=$ribbon,bold]THEME #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <d> #[fg=$bar,bg=$ribbon,bold]DETACH #[fg=$ribbon,bg=$bar]"
        mode_normal "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] Ctrl + #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <g> #[fg=$bar,bg=$ribbon,bold]LOCK #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <p> #[fg=$bar,bg=$ribbon,bold]PANE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <t> #[fg=$bar,bg=$ribbon,bold]TAB #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <n> #[fg=$bar,bg=$ribbon,bold]RESIZE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <h> #[fg=$bar,bg=$ribbon,bold]MOVE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <s> #[fg=$bar,bg=$ribbon,bold]SCROLL #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <o> #[fg=$bar,bg=$ribbon,bold]SESSION #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <q> #[fg=$bar,bg=$ribbon,bold]QUIT #[fg=$ribbon,bg=$bar] #[fg=$text,bg=$bar,bold] Alt + #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <r> #[fg=$bar,bg=$ribbon,bold]RENAME #[fg=$ribbon,bg=$bar]"
        mode_pane "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] PANE #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <hjkl> #[fg=$bar,bg=$ribbon,bold]FOCUS #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <n> #[fg=$bar,bg=$ribbon,bold]NEW #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <d> #[fg=$bar,bg=$ribbon,bold]DOWN #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <r> #[fg=$bar,bg=$ribbon,bold]RIGHT #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <s> #[fg=$bar,bg=$ribbon,bold]STACKED #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <x> #[fg=$bar,bg=$ribbon,bold]CLOSE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <f> #[fg=$bar,bg=$ribbon,bold]FULLSCREEN #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <w> #[fg=$bar,bg=$ribbon,bold]FLOATING #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <e> #[fg=$bar,bg=$ribbon,bold]EMBED #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <c> #[fg=$bar,bg=$ribbon,bold]RENAME #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <i> #[fg=$bar,bg=$ribbon,bold]PIN #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]BACK #[fg=$active,bg=$bar]"
        mode_tab "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] TAB #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <hl> #[fg=$bar,bg=$ribbon,bold]PREV/NEXT #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <1-9> #[fg=$bar,bg=$ribbon,bold]GO TO #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <n> #[fg=$bar,bg=$ribbon,bold]NEW #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <x> #[fg=$bar,bg=$ribbon,bold]CLOSE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <r> #[fg=$bar,bg=$ribbon,bold]RENAME #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <s> #[fg=$bar,bg=$ribbon,bold]SYNC #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <b> #[fg=$bar,bg=$ribbon,bold]BREAK PANE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <[]> #[fg=$bar,bg=$ribbon,bold]BREAK LEFT/RIGHT #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <Tab> #[fg=$bar,bg=$ribbon,bold]LAST #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]BACK #[fg=$active,bg=$bar]"
        mode_resize "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] RESIZE #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <hjkl> #[fg=$bar,bg=$ribbon,bold]GROW #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <HJKL> #[fg=$bar,bg=$ribbon,bold]SHRINK #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <-=> #[fg=$bar,bg=$ribbon,bold]SMALLER/BIGGER #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]BACK #[fg=$active,bg=$bar]"
        mode_move "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] MOVE #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <hjkl> #[fg=$bar,bg=$ribbon,bold]MOVE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <n> #[fg=$bar,bg=$ribbon,bold]NEXT #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <p> #[fg=$bar,bg=$ribbon,bold]PREV #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]BACK #[fg=$active,bg=$bar]"
        mode_scroll "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] SCROLL #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <jk> #[fg=$bar,bg=$ribbon,bold]SCROLL #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <hl> #[fg=$bar,bg=$ribbon,bold]PAGE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <du> #[fg=$bar,bg=$ribbon,bold]HALF PAGE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <[]> #[fg=$bar,bg=$ribbon,bold]PROMPTS #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <s> #[fg=$bar,bg=$ribbon,bold]SEARCH #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <e> #[fg=$bar,bg=$ribbon,bold]EDIT #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <c> #[fg=$bar,bg=$ribbon,bold]COPY OUTPUT #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]BACK #[fg=$active,bg=$bar]"
        mode_search "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] SEARCH #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <np> #[fg=$bar,bg=$ribbon,bold]NEXT/PREV #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <c> #[fg=$bar,bg=$ribbon,bold]CASE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <w> #[fg=$bar,bg=$ribbon,bold]WRAP #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <o> #[fg=$bar,bg=$ribbon,bold]WHOLE WORD #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <jk> #[fg=$bar,bg=$ribbon,bold]SCROLL #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]BACK #[fg=$active,bg=$bar]"
        mode_enter_search "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] SEARCH #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <Enter> #[fg=$bar,bg=$ribbon,bold]SEARCH #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]CANCEL #[fg=$active,bg=$bar]"
        mode_rename_tab "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] RENAME TAB #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <Enter> #[fg=$bar,bg=$ribbon,bold]DONE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]CANCEL #[fg=$active,bg=$bar]"
        mode_rename_pane "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] RENAME PANE #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <Enter> #[fg=$bar,bg=$ribbon,bold]DONE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]CANCEL #[fg=$active,bg=$bar]"
        mode_session "#[fg=$text,bg=$alert,bold] UNLOCKED #[fg=$alert,bg=$bar]#[fg=$text,bg=$bar,bold] SESSION #[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <d> #[fg=$bar,bg=$ribbon,bold]DETACH #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <w> #[fg=$bar,bg=$ribbon,bold]SESSIONS #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <l> #[fg=$bar,bg=$ribbon,bold]LAYOUTS #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <c> #[fg=$bar,bg=$ribbon,bold]CONFIG #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <p> #[fg=$bar,bg=$ribbon,bold]PLUGINS #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <s> #[fg=$bar,bg=$ribbon,bold]SHARE #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$ribbon]#[fg=$key,bg=$ribbon,bold] <a> #[fg=$bar,bg=$ribbon,bold]ABOUT #[fg=$ribbon,bg=$bar]#[fg=$bar,bg=$active]#[fg=$text,bg=$active,bold] <Esc> #[fg=$bar,bg=$active,bold]BACK #[fg=$active,bg=$bar]"
    }
}

keybinds {
    // Default bindings: https://github.com/zellij-org/zellij/blob/main/zellij-utils/assets/config/default.kdl
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
        bind "Alt t" { NewTab; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Alt d" { Detach; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt j" { MoveFocus "Left"; }
        bind "Alt l" { MoveFocus "Right"; }
        bind "Alt k" { MoveFocus "Down"; }
        bind "Alt i" { MoveFocus "Up"; }
        bind "Alt m" { ToggleTheme; }
    }
    renametab {
        // Native RenameTab drops into normal mode on Enter; return to locked
        bind "Enter" { SwitchToMode "locked"; }
    }
    normal {
        // Native RenameTab can only exit to one fixed mode, so rename via a
        // floating prompt instead. Lock while it's open so typed letters
        // reach the prompt, then the prompt switches back.
        bind "Alt r" {
            Run "sh" "-c" "printf 'Tab name: '; read -r n && [ -n \"$n\" ] && zellij action rename-tab \"$n\"; zellij action switch-mode normal" {
                floating true
                close_on_exit true
                name "Rename tab"
            }
            SwitchToMode "locked";
        }
    }
}
