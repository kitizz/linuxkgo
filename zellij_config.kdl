// As suggested here: https://www.reddit.com/r/zellij/comments/17863uf/comment/k4yjkqd/?utm_source=share&utm_medium=web2x&context=3
default_mode "locked"

// iTerm doesn't report its light/dark palette, so default to dark and toggle with Alt m
theme_dark "gruvbox-dark"
theme_light "gruvbox-light"
explicit_theme_hue "dark"

show_startup_tips false

pane_frames false

keybinds {
    // Default bindings: https://github.com/zellij-org/zellij/blob/main/zellij-utils/assets/config/default.kdl
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
        bind "Alt t" { NewTab; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Alt d" { Detach; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt j" { MoveFocus "Left"; }
        bind "Alt l" { MoveFocus "Right"; }
        bind "Alt k" { MoveFocus "Down"; }
        bind "Alt i" { MoveFocus "Up"; }
        bind "Alt m" { ToggleTheme; }
    }
    renametab {
        // Native RenameTab drops into normal mode on Enter; return to locked
        bind "Enter" { SwitchToMode "locked"; }
    }
    normal {
        // Native RenameTab can only exit to one fixed mode, so rename via a
        // floating prompt instead. Lock while it's open so typed letters
        // reach the prompt, then the prompt switches back.
        bind "Alt r" {
            Run "sh" "-c" "printf 'Tab name: '; read -r n && [ -n \"$n\" ] && zellij action rename-tab \"$n\"; zellij action switch-mode normal" {
                floating true
                close_on_exit true
                name "Rename tab"
            }
            SwitchToMode "locked";
        }
    }
}
